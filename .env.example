# =================================================================
# AI-Powered Multi-Source Opinion Intelligence Platform - Config
# =================================================================

# Server Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opinion_intel_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/opinion_intel_db

# Google Gemini API (Required for AI Analysis & Report Generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ANALYZER_MODEL=gemini-2.5-flash
GEMINI_REPORT_MODEL=gemini-2.5-flash

# Reddit API Credentials (Optional: for Reddit data collection)
# Create app at: https://www.reddit.com/prefs/apps (Script type)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=opinion-intel-app:v1.0 (by /u/your_username)

# YouTube Data API v3 (Optional: for YouTube comments collection)
# Enable API at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_youtube_api_key_here

# Local Storage Directory for Generated PDF Reports
STORAGE_DIR=./storage/reports
